# Google Gemini API Key (required for primary model)
# Get it from: https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional - fallback when Google quota exhausted)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (optional - FREE! Great fallback)
# Get it from: https://console.groq.com
# Groq offers FREE generous quota for testing
GROQ_API_KEY=your_groq_api_key_here

# Ollama (optional - completely FREE, runs locally)
# Download: https://ollama.ai
# Pull a model: ollama pull mistral
# Run in background: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
USE_GOOGLE_PRIMARY=false
